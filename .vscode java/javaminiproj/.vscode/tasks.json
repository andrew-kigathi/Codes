{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build javafx project",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "javac -cp '${workspaceFolder}\\lib\\javafx-sdk-26.0.1\\lib\\javafx.base.jar;${workspaceFolder}\\lib\\javafx-sdk-26.0.1\\lib\\javafx.graphics.jar;${workspaceFolder}\\lib\\javafx-sdk-26.0.1\\lib\\javafx.controls.jar;${workspaceFolder}\\lib\\*' -d '${workspaceFolder}\\bin' (Get-ChildItem '${workspaceFolder}\\src\\*.java')"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$javac"
        }
    ]
}
